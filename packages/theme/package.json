{
  "name": "@yss-ui/theme",
  "version": "1.0.3",
  "description": "YSS UI 主题包",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": ["dist", "styles"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "vite-plugin-dts": "^3.9.1"
  }
}
